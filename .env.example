# Skopiuj do .env (praca lokalna). Na serwerze zmienne ustawia hosting.
APP_ENV=dev
APP_NAME=[Nazwa]
APP_URL=http://localhost:8080
# Pusty = SQLite w storage/app.sqlite. Produkcja: postgres://user:haslo@host:5432/baza?sslmode=require
DATABASE_URL=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
CRON_TOKEN=zmien-mnie
PSI_KEY=
SIGNUP_OPEN=1
# Na serwerze: SIGNUP_OPEN=0 i SIGNUP_CODE=losowy-kod → rejestracja tylko pod /rejestracja?kod=losowy-kod
SIGNUP_CODE=
TERMS_URL=
PRIVACY_URL=
ADMIN_EMAILS=
# Testy bez sieci: odpowiedzi API z plików
# HTTP_FIXTURES=tests/fixtures/http
