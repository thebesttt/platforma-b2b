# Skopiuj do .env (praca lokalna). Na serwerze zmienne ustawia hosting.
APP_ENV=dev
APP_NAME=PerfectData
# perfectdata = granat i złoto jak na perfectdata.pl; puste = wygląd standardowy
APP_THEME=perfectdata
APP_URL=http://localhost:8080
# Pusty = SQLite w storage/app.sqlite. Produkcja: postgres://user:haslo@host:5432/baza?sslmode=require
DATABASE_URL=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
CRON_TOKEN=zmien-mnie
PSI_KEY=
# Token hurtowni danych CEIDG (dane.biznes.gov.pl): wyszukiwanie jednoosobowych działalności na liście potencjalnych klientów
CEIDG_TOKEN=
# Cloudflare Browser Run (wskaźniki A6 i E2 audytu AI). Bez nich te wskaźniki mają stan „brak pomiaru”.
CF_ACCOUNT_ID=
CF_BROWSER_TOKEN=
# Boty AI na witrynach za Cloudflare (uprawnienia Zone: Analytics Read i Zone Read). Puste: panel używa CF_BROWSER_TOKEN.
CF_ANALYTICS_TOKEN=
# Klucz konta usługi Google (treść pliku JSON albo base64): stałe połączenie z Search Console i Google Analytics, tylko odczyt.
# Bez niego działa wgrywanie plików z eksportu Search Console.
GOOGLE_SERVICE_ACCOUNT=
# Wysyłka e-maili przez Resend. Lokalnie (APP_ENV=dev) wiadomości są tylko zapisywane w tabeli outbox.
RESEND_API_KEY=
MAIL_FROM=
SIGNUP_OPEN=1
# Na serwerze: SIGNUP_OPEN=0 i SIGNUP_CODE=losowy-kod → rejestracja tylko pod /rejestracja?kod=losowy-kod
SIGNUP_CODE=
TERMS_URL=
PRIVACY_URL=
ADMIN_EMAILS=
# Testy bez sieci: odpowiedzi API z plików
# HTTP_FIXTURES=tests/fixtures/http
