#!/usr/bin/env php
<?php
/**
 * Polecenia administracyjne:
 *   php bin/console migrate            - utworzenie/aktualizacja tabel
 *   php bin/console import [od]        - import ogłoszeń BZP i TED (od: 'Y-m-d H:i:s' UTC) i dopasowanie do profili
 *   php bin/console results [dni] [ile] - wyniki przetargów z BZP (dni wstecz, ile ogłoszeń doczytać z cenami)
 *   php bin/console uokik:sync [lata]  - pobranie decyzji UOKiK o zatorach płatniczych
 *   php bin/console uokik:import pliki.html… - wgranie zapisanych stron listy decyzji (gdy rejestr blokuje serwer)
 *   php bin/console watchlist          - odświeżenie obserwowanych kontrahentów (alerty o zmianach)
 *   php bin/console daily              - wszystko powyżej (zadanie codzienne)
 *   php bin/console user:create e-mail hasło "Nazwa firmy" [NIP]
 *   php bin/console content:audit adres "fraza" [rodzaj] - audyt treści jednej strony, wynik w konsoli, bez zapisu do bazy
 *   php bin/console demo:seed          - konto demonstracyjne z przykładowymi danymi (tylko środowisko dev/test)
 */

declare(strict_types=1);

require __DIR__ . '/../src/bootstrap.php';

use App\Core\Auth;
use App\Core\Config;
use App\Core\Db;
use App\Core\Migrator;
use App\Modules\Companies\Companies;
use App\Modules\Companies\Uokik;
use App\Modules\Tenders\Importer;

$cmd = $argv[1] ?? 'help';
$out = static function (mixed $v): void {
    echo (is_string($v) ? $v : json_encode($v, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE)) . PHP_EOL;
};

try {
    switch ($cmd) {
        case 'migrate':
            $applied = (new Migrator(Db::get()))->migrate();
            $out($applied ? 'Zastosowano: ' . implode(', ', $applied) : 'Baza aktualna.');
            break;
        case 'import':
            $res = Importer::run($argv[2] ?? null);
            $out($res);
            exit(empty($res['errors']) ? 0 : 2);
        case 'results':
            // Wyniki przetargów z ostatnich N dni (domyślnie od ostatniego importu). Drugi argument: ile ogłoszeń doczytać.
            $days = (int) ($argv[2] ?? 0);
            $out(App\Modules\Tenders\Results::import($days > 0 ? gmdate('Y-m-d H:i:s', time() - $days * 86400) : null, (int) ($argv[3] ?? 400), 900));
            break;
        case 'uokik:sync':
            $out(Uokik::sync((int) ($argv[2] ?? 6)));
            break;
        case 'uokik:import':
            $n = 0;
            foreach (array_slice($argv, 2) as $file) {
                $n += Uokik::store(Uokik::parseList((string) file_get_contents($file)));
            }
            $out('Zapisano decyzji: ' . $n);
            break;
        case 'watchlist':
            $out(Companies::refreshWatched((int) ($argv[2] ?? 80)));
            break;
        case 'daily':
            $res = App\Http\CronController::daily();
            $out($res);
            if (!empty($res['import']['errors'])) {
                fwrite(STDERR, "Import zakończył się z błędami - szczegóły powyżej.\n");
                exit(2);
            }
            break;
        case 'user:create':
            [$email, $password, $company] = [$argv[2] ?? '', $argv[3] ?? '', $argv[4] ?? ''];
            $res = Auth::register($company, $argv[5] ?? '', '', $email, $password);
            $out($res['ok'] ? 'Utworzono konto ' . $email : 'Błąd: ' . $res['error']);
            exit($res['ok'] ? 0 : 1);
        case 'content:audit':
            // Audyt treści jednej strony bez zapisu do bazy: php bin/console content:audit <adres> "<fraza>" [article|product|home|other]
            if (($argv[2] ?? '') === '' || ($argv[3] ?? '') === '') {
                $out('Użycie: php bin/console content:audit <adres> "<fraza>" [article|product|home|other]');
                exit(1);
            }
            $s = App\Modules\Content\Measure::run($argv[2], $argv[3], $argv[4] ?? 'other');
            $t = $s['totals'];
            $out('Strona: ' . ($s['final_url'] ?? $argv[2]) . ' (kod ' . ($s['status'] ?? 0) . ', słów treści: ' . (int) ($s['facts']['words'] ?? 0) . ')');
            $out('Wynik: ' . ($t['score'] ?? '-') . ' / 100 (' . $t['points'] . ' z ' . $t['max'] . ' pkt zmierzonych)' . ($t['blocked'] ? ', niespełnione warunki konieczne: ' . implode(', ', $t['blocked']) : ''));
            foreach ($s['results'] as $code => $r) {
                $rule = App\Modules\Content\Ruleset::rule($code);
                $out(sprintf('%s %-12s %d/%d  %s: %s', $code, App\Modules\Content\Ruleset::STATES[$r['status']]['label'], $r['points'], $r['max'], $rule['name'], $r['value']));
                if ($r['evidence'] !== '') {
                    $out('     ' . $r['evidence']);
                }
            }
            break;
        case 'demo:seed':
            if (!Config::isDev()) {
                $out('demo:seed działa tylko przy APP_ENV=dev lub test.');
                exit(1);
            }
            require APP_ROOT . '/tests/demo_seed.php';
            $out(demo_seed());
            break;
        default:
            $lines = file(__FILE__);
            echo implode('', array_slice($lines, 2, 13));
    }
} catch (Throwable $e) {
    fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . ' (' . basename($e->getFile()) . ':' . $e->getLine() . ")\n");
    exit(1);
}
