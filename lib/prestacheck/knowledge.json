    "latest_9": "9.2.0",
    "latest_8": "8.2.8",
    "branches": [
      {
        "match": "^1\\.[0-5]\\.",
        "status": "eol",
        "note": "Wersja sprzed ponad dekady, bez jakichkolwiek poprawek bezpieczeństwa."
      },
      {
        "match": "^1\\.6\\.",
        "status": "eol",
        "note": "PrestaShop 1.6 nie dostaje poprawek bezpieczeństwa od czerwca 2019 r., a od kwietnia 2026 r. nie są już generowane dla niej paczki językowe."
      },
      {
        "match": "^1\\.7\\.",
        "status": "eol",
        "note": "Wsparcie rozszerzone PrestaShop 1.7 zakończyło się wraz z premierą PrestaShop 9.0 (czerwiec 2025 r.). Nowe luki nie są łatane."
      },
      {
        "match": "^8\\.[01]\\.",
        "status": "eol",
        "note": "Gałęzie 8.0 i 8.1 nie są już utrzymywane – poprawki bezpieczeństwa trafiają tylko do 8.2.x i 9.x."
      },
      {
        "match": "^8\\.2\\.",
        "status": "extended",
        "min_safe": "8.2.6",
        "recommended": "8.2.8",
        "latest": "8.2.8",
        "note": "PrestaShop 8.2 jest w fazie wsparcia rozszerzonego: tylko poprawki bezpieczeństwa, do premiery PrestaShop 10. Wersje starsze niż 8.2.6 mają krytyczną lukę XSS (CVE-2026-44212), przez którą niezalogowana osoba może przejąć panel administracyjny; 8.2.8 (sierpień 2026) łata kolejnych 5 luk."
      },
      {
        "match": "^9\\.0\\.",
        "status": "outdated",
        "note": "Gałąź 9.0 nie dostaje już poprawek. Ma krytyczną lukę XSS (CVE-2026-44212), poprawioną dopiero w 9.1.1, oraz luki naprawione w 9.1.5."
      },
      {
        "match": "^9\\.1\\.",
        "status": "previous",
        "min_safe": "9.1.1",
        "recommended": "9.1.5",
        "latest": "9.1.5",
        "note": "Od 30.09.2026 r. aktualną wersją jest PrestaShop 9.2. Wersje starsze niż 9.1.1 mają krytyczną lukę XSS (CVE-2026-44212), a 9.1.5 (sierpień 2026) łata kolejnych 5 luk."
      },
      {
        "match": "^9\\.2\\.",
        "status": "current",
        "latest": "9.2.0",
        "note": "Aktualna gałąź PrestaShop."
      },
      {
        "match": "^(9\\.[3-9]|[1-9]\\d)\\.",
        "status": "current",
        "note": "Wersja nowsza niż nasza baza – aktualna."
      }
    ],
